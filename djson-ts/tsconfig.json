{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext", 
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM"], 
        "types": ["node"],
        "declaration": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"]
}